# FarmFit optional configuration. The app works with NONE of these set (demo geometry + keyless public APIs).
# Copy to backend/.env.local (loaded by your shell / process manager) - never commit real values.

# Live cadastral parcels (only if you obtain a real ArcGIS FeatureServer / MapServer layer query URL):
# QATAR_PARCEL_QUERY_URL=https://<host>/arcgis/rest/services/<folder>/<service>/FeatureServer/0/query
# QATAR_GIS_TOKEN=<token, only if the service requires authentication>
# QATAR_PARCEL_ID_FIELD=PARCEL_ID
