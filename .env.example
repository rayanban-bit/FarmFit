# FarmFit configuration. The app needs NONE of these: every integrated data source is public and keyless
# (Qatar cadastral FeatureServer, Qatar Open Data, NASA POWER, ISRIC SoilGrids WCS, OpenStreetMap Overpass).
# Copy to backend/.env.local if you need them. Never commit real values.

# Point the cadastral adapter at a different ArcGIS layer (defaults to the public Qatar CadastrePlots layer 0):
# QATAR_PARCEL_LAYER_URL=https://services.gisqatar.org.qa/server/rest/services/Vector/CadastrePlots/FeatureServer/0

# Only if YOUR deployment of that service requires a token. The public service does not.
# QATAR_GIS_TOKEN=

# Frontend -> backend URL (frontend/.env.local); defaults to http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
